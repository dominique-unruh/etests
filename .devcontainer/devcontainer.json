{
  "image": "ubuntu:24.04",
  "remoteUser": "dev",
  "features": {
    "./features/user": {
      "username": "dev"
    },
    "./features/apt": {},
    "./features/claude": {
      "dangerousPermissions": true
    },
    "./features/caveman": {
      "mode": "ultra"
    },
    "./features/sbt": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": true,
      "mobyBuildxVersion": "latest",
      "dockerDashComposeVersion": "latest",
      "installDockerBuildx": true,
      "installDockerComposeSwitch": false,
      "socketPath": "/var/run/docker-host.sock"
    }
  },
  "forwardPorts": [9001],
  "appPort": [9001],
/*  "forwardPorts": [9000],
  "appPort": [9000],
  "portsAttributes": {
    "9000": {
      "label": "my-service",
      "onAutoForward": "notify"
    }
  }*/
}
